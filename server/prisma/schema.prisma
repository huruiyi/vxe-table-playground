generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  name      String    @db.VarChar(50)
  nickname  String    @default("") @db.VarChar(50)
  /// 0=女 1=男
  sex       Int       @default(0) @db.TinyInt
  age       Int       @default(0)
  role      String    @default("") @db.VarChar(20)
  deptId    Int       @default(0) @map("dept_id") @db.UnsignedInt
  email     String    @default("") @db.VarChar(100)
  phone     String    @default("") @db.VarChar(20)
  address   String    @default("") @db.VarChar(200)
  salary    Decimal   @default(0) @db.Decimal(10, 2)
  joinDate  DateTime? @map("join_date") @db.Date
  /// 0=禁用 1=启用
  status    Int       @default(1) @db.TinyInt
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([name], map: "idx_name")
  @@index([deptId], map: "idx_dept")
  @@map("users")
}

model Department {
  id       Int    @id @default(autoincrement()) @db.UnsignedInt
  parentId Int    @default(0) @map("parent_id") @db.UnsignedInt
  name     String @db.VarChar(50)
  manager  String @default("") @db.VarChar(50)
  empCount Int    @default(0) @map("emp_count") @db.UnsignedInt

  @@index([parentId], map: "idx_parent")
  @@map("departments")
}
